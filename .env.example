# Copy to .env (done automatically on Codespace creation). .env is git-ignored.
# Anything set here is available to tests as __ENV.NAME.
# Values already exported in your shell override these.

# Target
BASE_URL=https://quickpizza.grafana.com
TARGET_PATH=/

# Auth (optional)
AUTH_TOKEN=
API_KEY=
API_KEY_HEADER=x-api-key

# Default thresholds
P95_MS=500
MAX_ERROR_RATE=0.01

# Seconds of think time between iterations (randomized 50%-150%). 0 = none.
THINK_TIME=1

# ---- Per-API settings -------------------------------------------------
# Give each API its own prefixed variables so keys don't collide.

# stock2api (scripts/stock2api.js)
STOCK_API_URL=https://axway-appc-se-design.sandbox.fusion.services.axway.com:4443/stock2api
STOCK_API_KEY=
STOCK_API_KEY_HEADER=x-api-key
